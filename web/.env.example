# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# CRITICAL: Required for production builds
# The frontend will fail to build without these in production
# Set these in Railway environment variables BEFORE deploying
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase (https://supabase.com/dashboard)
# Only anon key is used in the frontend for client-side operations.
# Service role key belongs in backend/.env ONLY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: only if the web app talks to Upstash directly later
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
