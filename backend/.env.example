PORT=5000
FRONTEND_URL=http://localhost:3000

# Clerk Backend API secret from https://dashboard.clerk.com (API keys).
# Placeholder only — put the real value in backend/.env, never commit it.
CLERK_SECRET_KEY=

# Length of the one-time Pro trial granted on a user's first authenticated request.
# Change this value to adjust duration; no code change needed.
PRO_TRIAL_DURATION_HOURS=24

# Upstash Redis REST credentials from https://console.upstash.com
# Placeholder only — put the real values in backend/.env, never commit them.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Supabase/PostgreSQL entitlement store.
# When both are set, trials persist in user_entitlements (see sql/001_user_entitlements.sql).
# When unset, the backend uses the local file store at backend/data/entitlements.json.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
